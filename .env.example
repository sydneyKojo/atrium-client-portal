DATABASE_URL=postgres://localhost:5432/client_portal
# Public URL of the app, used for Stripe redirect links.
APP_URL=http://localhost:3400
# Stripe test keys. Leave blank for demo mode: "Pay" marks the invoice paid without charging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shows one-click demo sign-in buttons on the login page. Turn off for a real deployment.
DEMO_MODE=true
